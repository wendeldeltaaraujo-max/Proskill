# Variáveis de ambiente do servidor Node (copie para .env ou configure no painel da hospedagem). NUNCA publique estes valores.
PORT=8787
TRUST_PROXY=1                                  # 1 quando estiver atrás de proxy/hospedagem (Render, Railway, Fly, Nginx…)
PUBLIC_ORIGIN=https://seusite.com.br           # endereço do site
CONTENT_ORIGIN=https://cursos.seusite.com.br   # OUTRO endereço (domínio separado) que aponta para este mesmo servidor
ADMIN_EMAIL=wendel.delta.araujo@gmail.com
DATABASE_URL=                                  # string de conexão do Neon (Connect no painel do Neon)
CONTENT_TOKEN_SECRET=                          # aleatório e longo: openssl rand -base64 48
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Armazenamento dos cursos — escolha UM:
# (a) Compatível com S3 (recomendado em hospedagens sem disco permanente): R2, AWS S3, Backblaze B2, MinIO…
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# (b) Pasta local (VPS/servidor com disco persistente):
# STORAGE_DIR=./data/storage
